# Copie para .env (na raiz do repositório) e preencha. O .env nunca vai para o Git.

# Steam Web API: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Banco local (Docker)
POSTGRES_DB=dota2coach
POSTGRES_USER=dota2coach
POSTGRES_PASSWORD=troque_por_uma_senha_forte
POSTGRES_PORT=5432

# Redis local (Docker)
REDIS_URL=redis://localhost:6379

# App
APP_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

# Opcionais
OPENDOTA_API_KEY=
ANTHROPIC_API_KEY=
